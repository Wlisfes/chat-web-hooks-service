# Node.js 运行环境；生产部署使用 production，本地开发使用 development。
NODE_ENV=production
# HTTP 监听端口：Observe 回执、健康检查和 Swagger。
PORT=5110

# 容器时区；用于统一日志和业务时间。
TZ=Asia/Shanghai
# Nacos 配置中心 Data ID；配置分组默认使用 DEFAULT_GROUP。
NACOS_CONFIG_DATA_ID=chat-web-hooks-service.yaml
# 是否将服务实例注册到 Nacos 服务发现。
NACOS_REGISTER_ENABLED=true
# Nacos 命名空间 ID（不是命名空间显示名称）。
NACOS_NAMESPACE=replace-with-nacos-namespace-id
# Nacos 服务地址，格式为 host:port。
NACOS_SERVER=replace-with-nacos-host:8848
# Nacos 服务发现中的服务名称。
NACOS_SERVICE_NAME=chat-web-hooks-service
# 可选。注册到 Nacos 的跨主机可达地址。留空则自动探测网卡 IP。
# NACOS_REGISTER_IP=
# Nacos 鉴权密码；示例文件使用占位符，真实值只保存在实际 .env。
NACOS_PASSWORD=replace-with-nacos-password
# Nacos 鉴权用户名。
NACOS_USERNAME=nacos
# Nacos 注册实例权重；支持大于 0 且不超过 10000 的数值。
NACOS_REGISTER_WEIGHT=1
# 是否启用 Nacos 配置中心订阅。
NACOS_CONFIG_ENABLED=true
# 是否要求 Nacos 配置必须成功加载；为 true 时加载失败将阻止服务启动。
NACOS_CONFIG_REQUIRED=true
# 是否启用 Nacos 服务发现。
NACOS_DISCOVERY_ENABLED=true
# 是否要求服务发现初始化成功；为 false 时短暂不可用不会阻止服务启动。
NACOS_DISCOVERY_REQUIRED=false
# Docker 外部网络名称；各微服务通过该网络互通。
DOCKER_NETWORK=chat-web-infrastructure
# HTTP 端口绑定地址；只供本机健康检查和 Swagger。
HOST_BIND_IP=127.0.0.1
